              "raw": "{\n  \"firstname\": \"Alice\",\n  \"lastname\": \"Smith\",\n  \"email\": \"alicesmith.test@laverdad.edu.ph\",\n  \"phone\": \"+639123456780\",\n  \"password\": \"password123\",\n  \"role\": \"admin\",\n  \"department\": \"BS Information Systems\"\n}"
